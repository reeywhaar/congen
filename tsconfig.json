{
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./dist/",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "jsx": "react",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "target": "ES6",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "./frontend/src/**/*"
  ],
  "exclude": [
    "./build/**/*"
  ]
}